local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")

-- Configuration
local PLACE_ID = game.PlaceId
local MAX_PLAYERS = 4 -- Max number of players allowed in the target server
local MAX_PAGES_TO_CHECK = 5 -- Limit the number of pages to check to prevent infinite loops/excessive requests

-- State
local player = Players.LocalPlayer
local foundServer = nil
local currentPageCursor = ""
local pagesChecked = 0
local success = false -- Track if the operation was successful

-- The API endpoint for public servers
local API_URL_FORMAT = "https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100&cursor=%s"

-- Use a pcall to safely handle HTTP requests and JSON decoding
local function getServersPage(cursor)
    local url = API_URL_FORMAT:format(PLACE_ID, cursor)
    local serverData = nil
    
    local success, response = pcall(function()
        -- Note: game:HttpGet() is often used in exploits/client-side script injection. 
        -- In a standard Roblox game script (server or client), use HttpService:RequestAsync() for security and better control.
        -- Since this is clearly a client-side server-hopping script, we'll keep the HttpGet/format structure but wrap it in pcall.
        return game:HttpGet(url)
    end)

    if success and response then
        local decodeSuccess, decodedData = pcall(HttpService.JSONDecode, HttpService, response)
        if decodeSuccess and decodedData and decodedData.data then
            return true, decodedData
        end
    end
    
    return false, nil
end

-- Main Server Search Loop
repeat
    pagesChecked += 1

    local ok, serversPage = getServersPage(currentPageCursor)

    if ok then
        -- Iterate through the servers on the current page
        for _, server in ipairs(serversPage.data) do
            -- 1. Must have a player count less than or equal to MAX_PLAYERS
            -- 2. Must not be the current server (game.JobId is the instance ID)
            if server.playing <= MAX_PLAYERS and server.id ~= game.JobId then
                foundServer = server
                success = true
                break
            end
        end

        -- Move to the next page's cursor
        currentPageCursor = serversPage.nextPageCursor
    else
        warn("⚠️ Gagal mengambil halaman server. Menghentikan pencarian.")
        break -- Exit loop on failure to fetch data
    end

    -- Stop if we found a server, or if there are no more pages, or if we hit the page limit
until foundServer or not currentPageCursor or pagesChecked >= MAX_PAGES_TO_CHECK

-- Teleport Logic
if foundServer then
    print(("✅ Ditemukan server yang cocok! ID: %s, Pemain: %d"):format(foundServer.id, foundServer.playing))
    -- Teleport the player
    TeleportService:TeleportToPlaceInstance(PLACE_ID, foundServer.id, player)
else
    if success and pagesChecked >= MAX_PAGES_TO_CHECK then
        warn("⚠️ Mencapai batas pencarian %d halaman tanpa menemukan server yang cocok." :format(MAX_PAGES_TO_CHECK))
    elseif success then
        warn("⚠️ Tidak ada server yang memenuhi syarat setelah memeriksa semua halaman.")
    end
end
